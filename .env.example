# =============================================================================
# .env.example — Variables d'environnement de l'application RH
#
# UTILISATION :
#   cp .env.example .env
#   Remplir chaque valeur dans .env
#   Ne JAMAIS commiter .env dans Git (il est dans .gitignore)
# =============================================================================

# Profil Spring actif : dev ou prod
SPRING_PROFILES_ACTIVE=prod

# Port d'écoute de l'application (défaut : 8222)
PORT=8222

# =============================================================================
# Base de données H2 (profil prod)
# H2_PATH : chemin sans extension vers le fichier de base
#   Ex: /data/rhdb  → crée /data/rhdb.mv.db
# DB_USERNAME et DB_PASSWORD : identifiants H2 (pas ceux de Spring Security)
# =============================================================================
H2_PATH=/data/rhdb
DB_USERNAME=rh_user
DB_PASSWORD=CHANGE_ME_strong_password_here

# =============================================================================
# Compte administrateur initial
# Créé au premier démarrage si aucun admin n'existe.
# ADMIN_PASSWORD doit contenir au moins 12 caractères.
# =============================================================================
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@votre-domaine.com
ADMIN_PASSWORD=CHANGE_ME_admin_password_here
